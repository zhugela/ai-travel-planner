{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Travel Planner Feature List",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "updated", "status_values", "features"],
  "properties": {
    "project": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "status_values": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["not_started", "in_progress", "blocked", "passing"]
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "area",
          "title",
          "user_visible_behavior",
          "dependencies",
          "status",
          "verification",
          "evidence",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[0-9]{3}$"
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "area": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "user_visible_behavior": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F-[0-9]{3}$"
            }
          },
          "status": {
            "type": "string",
            "enum": ["not_started", "in_progress", "blocked", "passing"]
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
